#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="$ROOT_DIR/.micwise-dev"
BACKEND_PID_FILE="$STATE_DIR/backend.pid"
FRONTEND_PID_FILE="$STATE_DIR/frontend.pid"
BACKEND_LOG="$STATE_DIR/backend.log"
FRONTEND_LOG="$STATE_DIR/frontend.log"
BACKEND_DEPS_STAMP="$STATE_DIR/backend-deps.stamp"
FRONTEND_DEPS_STAMP="$STATE_DIR/frontend-deps.stamp"

HOST="${MICWISE_HOST:-127.0.0.1}"
PORT="${MICWISE_PORT:-8000}"
VITE_HOST="${MICWISE_VITE_HOST:-127.0.0.1}"
VITE_PORT="${MICWISE_VITE_PORT:-5173}"
PYTHON_BIN="${MICWISE_PYTHON:-$ROOT_DIR/.venv/bin/python}"

mkdir -p "$STATE_DIR"

usage() {
	cat <<USAGE
Usage: scripts/micwise-dev <command>

Commands:
  start     Start backend and frontend dev servers
  stop      Stop both dev servers
  restart   Stop, then start both dev servers
  status    Show whether the dev servers are running
  logs      Tail backend and frontend logs

URLs:
  Frontend: http://$VITE_HOST:$VITE_PORT/
  Backend:  http://$HOST:$PORT/
USAGE
}

is_running() {
	local pid="${1:-}"
	[[ -n "$pid" ]] && kill -0 "$pid" >/dev/null 2>&1
}

pid_from_file() {
	local file="$1"
	if [[ -f "$file" ]]; then
		tr -d '[:space:]' < "$file"
	fi
	return 0
}

start_process() {
	local name="$1"
	local pid_file="$2"
	local log_file="$3"
	shift 3

	local pid
	pid="$(pid_from_file "$pid_file")"
	if is_running "$pid"; then
		printf '%s already running (pid %s)\n' "$name" "$pid"
		return
	fi

	printf 'Starting %s...\n' "$name"
	(
		cd "$ROOT_DIR"
		nohup "$@" >"$log_file" 2>&1 </dev/null &
		echo "$!" > "$pid_file"
	)
}

newer_than() {
	local target="$1"
	shift

	if [[ ! -e "$target" ]]; then
		return 0
	fi

	local path
	for path in "$@"; do
		if [[ -e "$path" ]] && find "$path" -newer "$target" -print -quit | grep -q .; then
			return 0
		fi
	done

	return 1
}

ensure_python() {
	if [[ -x "$PYTHON_BIN" ]]; then
		return
	fi

	if [[ "$PYTHON_BIN" != "$ROOT_DIR/.venv/bin/python" ]]; then
		printf 'Python virtualenv not found at %s\n' "$PYTHON_BIN" >&2
		printf 'Create it first, or set MICWISE_PYTHON.\n' >&2
		exit 1
	fi

	printf 'Creating Python virtualenv...\n'
	python3 -m venv "$ROOT_DIR/.venv"
	"$PYTHON_BIN" -m pip install -U pip
}

ensure_backend_deps() {
	local requirements="$ROOT_DIR/backend/requirements.txt"

	if newer_than "$BACKEND_DEPS_STAMP" "$requirements"; then
		printf 'Installing backend dependencies...\n'
		"$PYTHON_BIN" -m pip install -r "$requirements"
		touch "$BACKEND_DEPS_STAMP"
	fi
}

ensure_npm() {
	if ! command -v npm >/dev/null 2>&1; then
		printf 'npm is required for frontend install/build.\n' >&2
		exit 1
	fi
}

ensure_frontend_deps() {
	local package_json="$ROOT_DIR/frontend/package.json"
	local package_lock="$ROOT_DIR/frontend/package-lock.json"

	if [[ ! -d "$ROOT_DIR/frontend/node_modules" ]] || newer_than "$FRONTEND_DEPS_STAMP" "$package_json" "$package_lock"; then
		printf 'Installing frontend dependencies...\n'
		npm --prefix "$ROOT_DIR/frontend" install
		touch "$FRONTEND_DEPS_STAMP"
	fi
}

build_frontend_if_needed() {
	local dist_index="$ROOT_DIR/frontend/dist/index.html"

	if newer_than "$dist_index" \
		"$ROOT_DIR/frontend/src" \
		"$ROOT_DIR/frontend/index.html" \
		"$ROOT_DIR/frontend/package.json" \
		"$ROOT_DIR/frontend/package-lock.json" \
		"$ROOT_DIR/frontend/styles.css"; then
		printf 'Building frontend for backend-served UI...\n'
		npm --prefix "$ROOT_DIR/frontend" run build
	else
		printf 'Frontend build is up to date.\n'
	fi
}

prepare() {
	ensure_python
	ensure_backend_deps
	ensure_npm
	ensure_frontend_deps
	build_frontend_if_needed
}

stop_process() {
	local name="$1"
	local pid_file="$2"
	local pid
	pid="$(pid_from_file "$pid_file")"

	if ! is_running "$pid"; then
		printf '%s is not running\n' "$name"
		rm -f "$pid_file"
		return
	fi

	printf 'Stopping %s (pid %s)...\n' "$name" "$pid"
	kill "$pid" >/dev/null 2>&1 || true
	for _ in {1..30}; do
		if ! is_running "$pid"; then
			rm -f "$pid_file"
			return
		fi
		sleep 0.1
	done
	kill -9 "$pid" >/dev/null 2>&1 || true
	rm -f "$pid_file"
}

start() {
	prepare

	start_process "backend" "$BACKEND_PID_FILE" "$BACKEND_LOG" \
		"$PYTHON_BIN" -m uvicorn app.main:app --app-dir backend --reload --host "$HOST" --port "$PORT"
	start_process "frontend" "$FRONTEND_PID_FILE" "$FRONTEND_LOG" \
		npm --prefix frontend run dev -- --host "$VITE_HOST" --port "$VITE_PORT"

	printf '\nMic-Wise dev is starting.\n'
	printf 'Frontend: http://%s:%s/\n' "$VITE_HOST" "$VITE_PORT"
	printf 'Backend:  http://%s:%s/\n' "$HOST" "$PORT"
	printf 'Logs:     scripts/micwise-dev logs\n'
}

stop() {
	stop_process "frontend" "$FRONTEND_PID_FILE"
	stop_process "backend" "$BACKEND_PID_FILE"
}

status_one() {
	local name="$1"
	local pid_file="$2"
	local pid
	pid="$(pid_from_file "$pid_file")"
	if is_running "$pid"; then
		printf '%s: running (pid %s)\n' "$name" "$pid"
	else
		printf '%s: stopped\n' "$name"
	fi
}

case "${1:-}" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	status)
		status_one "backend" "$BACKEND_PID_FILE"
		status_one "frontend" "$FRONTEND_PID_FILE"
		;;
	logs)
		tail -f "$BACKEND_LOG" "$FRONTEND_LOG"
		;;
	-h|--help|help|"")
		usage
		;;
	*)
		usage >&2
		exit 1
		;;
esac
